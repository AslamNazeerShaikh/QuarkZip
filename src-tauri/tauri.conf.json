{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuarkZip",
  "version": "0.1.0",
  "identifier": "com.quarkzip.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuarkZip",
        "width": 792,
        "height": 660,
        "minWidth": 792,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 24 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/7zz"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
