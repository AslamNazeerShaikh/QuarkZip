{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "swift-developer",
  "instructions": ["AGENTS.md"],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr *", "effect": "deny" },
    { "action": "shell", "resource": "chmod 777 *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "* | bash*", "effect": "deny" },
    { "action": "shell", "resource": "* | sh*", "effect": "deny" },
    { "action": "shell", "resource": "curl * | *", "effect": "deny" },

    { "action": "read", "resource": "**/.env*", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/secrets.*", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.*", "effect": "deny" },

    { "action": "edit", "resource": "vendor/7zip/**", "effect": "deny" },
    { "action": "edit", "resource": ".git/**", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "ui-skills": {
        "type": "remote",
        "url": "https://www.ui-skills.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  },
  "websearch": {
    "provider": "random"
  },
  "watcher": {
    "ignore": [".build/**", "vendor/**", "shots/**", "dist/**"]
  },
  "experimental": {
    "todo": true
  }
}
