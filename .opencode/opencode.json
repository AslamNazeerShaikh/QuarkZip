{
  "$schema": "https://opencode.ai/config.json",
  "version": "1.0.0",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "opencode": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "project": {
    "name": "QuarkZip",
    "description": "Visual 7-Zip archive manager for macOS/Windows/Linux. Tauri 2 + React + Tailwind v4 frontend with Rust backend shelling out to a pinned 7-Zip console sidecar.",
    "type": "tauri"
  },
  "instructions": ["AGENTS.md", "README.md"],
  "agents": {
    "default": "tauri-app-assistant",
    "list": [
      "tauri-app-assistant",
      "rust-developer",
      "code-reviewer",
      "test-writer",
      "documentation-writer",
      "macos-design-reviewer"
    ]
  },
  "skills": {
    "enabled": ["tauri-development", "macos-design"]
  },
  "commands": {
    "custom": [
      "dev",
      "build",
      "tauri-build",
      "check",
      "test",
      "fetch-7zz",
      "clean"
    ]
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": true,
  "plugin": [],
  "mcp": {
    "ui-skills": {
      "type": "remote",
      "url": "https://www.ui-skills.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "whiteboard": {
      "type": "local",
      "command": ["sh", "-c", "exec \"$HOME/.local/bin/whiteboard\" mcp"],
      "enabled": true
    }
  }
}
