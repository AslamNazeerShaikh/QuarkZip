# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
vendor/7zz-cache

# Playwright e2e artifacts
test-results/
playwright-report/
playwright/.cache/

# 7zz sidecar binaries are fetched at build time (see scripts/fetch-7zz.sh).
# To check them in instead, delete the two lines below.
src-tauri/binaries/7zz-*
src-tauri/binaries/*.exe

# graphify machine-local sidecars (interpreter path + scan root differ per
# machine; the skill regenerates both on every run, so never commit them)
graphify-out/.graphify_python
graphify-out/.graphify_root
# graphify local-only outputs (per https://github.com/Graphify-Labs/graphify
# "Team setup": graphify-out/ itself is meant to be committed, but these are
# machine-local / regenerable and must stay out of git)
graphify-out/cost.json
graphify-out/cache/
graphify-out/last_query_stamp
# graphify curated-graph backups (auto-created dated snapshots on every
# `graphify update`; regenerable, only bloat the repo)
graphify-out/20*/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
